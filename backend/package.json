{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:indexes": "tsx src/scripts/ensure-indexes.ts",
    "retention:cleanup": "tsx src/scripts/retention-cleanup.ts",
    "retention:dry-run": "tsx src/scripts/retention-cleanup.ts --dry-run",
    "test:retention": "node --import tsx --test test/retention-protection.test.ts",
    "test:seed": "node --import tsx --test test/seed-fixtures.test.ts",
    "test:retry": "node --import tsx --test test/retry-policy.test.ts",
    "test:soft-delete": "node --import tsx --test test/soft-delete.test.ts",
    "test:degradation": "node --import tsx --test test/provider-degradation.test.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "db:seed": "tsx src/scripts/seed-fixtures.ts"
  },
  "dependencies": {
    "mongodb": "^6.10.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
